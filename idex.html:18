<!-- ═══════════════ AUTENTICAÇÃO ═══════════════ -->
<div class="auth" id="authView" hidden>
  <section class="auth-brand-panel">
    <canvas class="auth-scene" id="authScene" aria-hidden="true"></canvas>
    <div class="auth-brand-content">
      <div class="brand brand-lg">
        <span class="brand-mark"><span></span></span>
        <span>Nox<em>Mob</em></span>
      </div>
      <p class="eyebrow"><span class="pulse-dot"></span> SmartPOS Unificado · Cloudflare Edge</p>
      <h1>Uma operação inteira,<br/><span class="grad-text">em uma única órbita.</span></h1>
      <p class="auth-lead">PDV, hotel com palma, frigobar inteligente, WhatsApp com IA, PIX e carteiras digitais. Login por e-mail ou CPF/CNPJ, dados persistidos no D1 e auditoria de acessos na borda da Cloudflare.</p>
      <div class="auth-features">
        <div class="auth-feature"><svg><use href="#i-sparkles"/></svg><strong>IA Grok + Llama</strong><span>Copiloto e respostas automáticas</span></div>
        <div class="auth-feature"><svg><use href="#i-wallet"/></svg><strong>Wallet-first</strong><span>PIX e wallets sem armazenar cartões</span></div>
        <div class="auth-feature"><svg><use href="#i-id"/></svg><strong>CPF / CNPJ</strong><span>Acesso e rastreabilidade por documento</span></div>
      </div>
      <div class="auth-trust">
        <span><svg><use href="#i-shield"/></svg> Sessões opacas</span>
        <span><svg><use href="#i-lock"/></svg> PBKDF2 210k</span>
        <span><svg><use href="#i-bolt"/></svg> PWA instalável</span>
      </div>
    </div>
  </section>

  <section class="auth-form-panel">
    <div class="auth-card">
      <div class="auth-card-head">
        <div class="brand">
          <span class="brand-mark"><span></span></span>
          <span>Nox<em>Mob</em></span>
        </div>
        <span class="chip chip-mint" id="authEnvChip">Edge</span>
      </div>
      <div class="auth-tabs" role="tablist">
        <button type="button" class="auth-tab active" data-auth-tab="login">Entrar</button>
        <button type="button" class="auth-tab" data-auth-tab="register">Criar conta</button>
        <button type="button" class="auth-tab" data-auth-tab="forgot">Recuperar</button>
      </div>

      <div class="auth-panel active" data-auth-panel="login">
        <h2>Bem-vindo de volta</h2>
        <p class="muted small">Entre com seu e-mail ou CPF/CNPJ.</p>
        <form id="loginForm" autocomplete="on">
          <label class="field"><span>E-mail ou CPF/CNPJ</span><input type="text" id="loginEmail" name="identificador" autocomplete="username" placeholder="voce@empresa.com ou 000.000.000-00" required/></label>
          <label class="field"><span>Senha</span><div class="input-reveal"><input type="password" id="loginPassword" name="password" autocomplete="current-password" placeholder="••••••••" required/><button type="button" class="reveal" data-reveal="loginPassword" aria-label="Mostrar senha"><svg><use href="#i-eye"/></svg></button></div></label>
          <button type="submit" class="btn btn-primary btn-block" id="loginSubmit">Entrar no painel <svg><use href="#i-arrow"/></svg></button>
        </form>
      </div>

      <div class="auth-panel" data-auth-panel="register">
        <h2>Solicitar acesso</h2>
        <p class="muted small">Informe um CPF ou CNPJ válido. Um administrador aprova o operador antes do primeiro login.</p>
        <form id="registerForm">
          <label class="field"><span>Nome completo</span><input type="text" id="registerName" autocomplete="name" placeholder="Seu nome" required/></label>
          <label class="field"><span>E-mail</span><input type="email" id="registerEmail" autocomplete="email" placeholder="voce@empresa.com" required/></label>
          <label class="field"><span>CPF ou CNPJ</span><input type="text" id="registerDoc" inputmode="numeric" autocomplete="off" placeholder="000.000.000-00" maxlength="18" required/></label>
          <label class="field"><span>Senha</span><div class="input-reveal"><input type="password" id="registerPassword" autocomplete="new-password" minlength="8" placeholder="Mínimo de 8 caracteres" required/><button type="button" class="reveal" data-reveal="registerPassword" aria-label="Mostrar senha"><svg><use href="#i-eye"/></svg></button></div></label>
          <p class="hint" style="margin:-4px 0 13px">O CPF/CNPJ fica vinculado à sua conta para login e auditoria de acesso. Somente dígitos são armazenados.</p>
          <button type="submit" class="btn btn-primary btn-block" id="registerSubmit">Solicitar cadastro</button>
        </form>
      </div>

      <div class="auth-panel" data-auth-panel="forgot">
        <h2>Recuperar senha</h2>
        <p class="muted small">Enviaremos um link seguro se o e-mail existir.</p>
        <form id="forgotForm">
          <label class="field"><span>E-mail da conta</span><input type="email" id="forgotEmail" autocomplete="email" placeholder="voce@empresa.com" required/></label>
          <button type="submit" class="btn btn-primary btn-block" id="forgotSubmit">Enviar instruções</button>
        </form>
        <form id="resetForm" hidden>
          <p class="hint">Informe o token recebido e crie uma nova senha.</p>
          <label class="field"><span>E-mail</span><input type="email" id="resetEmail" required/></label>
          <label class="field"><span>Token</span><input type="text" id="resetToken" placeholder="Token de recuperação" required/></label>
          <label class="field"><span>Nova senha</span><input type="password" id="resetPassword" minlength="8" autocomplete="new-password" required/></label>
          <button type="submit" class="btn btn-primary btn-block" id="resetSubmit">Redefinir senha</button>
        </form>
      </div>

      <div class="auth-msg" id="authMsg" hidden></div>
      <p class="auth-legal">O NoxMob não solicita nem armazena dados de cartão. CPF/CNPJ é usado apenas para identificação, login e auditoria de acessos.</p>
    </div>
    <p class="auth-foot">ws.droppfy.com · Cloudflare Workers + D1 · <span id="authVersion">v2.2</span></p>
  </section>
</div>

